rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isHouseholdMember(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
    }

    function willBeHouseholdMember(householdId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/households/$(householdId))
        && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /{collectionName}/{documentId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /invites/{inviteCode} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.size() == 1
        && request.auth.uid in request.resource.data.memberUids;

      allow read: if isHouseholdMember(householdId);

      allow update: if isHouseholdMember(householdId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids.size() <= 2
        && request.resource.data.memberUids.hasAll(resource.data.memberUids);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /joinRequests/{requesterUid} {
        allow create: if signedIn()
          && request.auth.uid == requesterUid
          && request.resource.data.requesterUid == requesterUid
          && request.resource.data.status == "pending"
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.householdId == householdId
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.active == true;

        allow read: if isHouseholdMember(householdId)
          || (signedIn() && request.auth.uid == requesterUid);

        allow update: if isHouseholdMember(householdId);
        allow delete: if isHouseholdMember(householdId)
          || (signedIn() && request.auth.uid == requesterUid);
      }

      match /members/{memberUid} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if isHouseholdMember(householdId)
          || willBeHouseholdMember(householdId);
      }

      match /{collectionName}/{documentId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isHouseholdMember(householdId)
          || willBeHouseholdMember(householdId);
      }
    }
  }
}
