{
  "rules": {
    "presenceHouseholds": {
      "$householdId": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
        ".write": "auth != null && !data.exists() && newData.child('ownerUid').val() === auth.uid && newData.child('members').child(auth.uid).val() === true",
        "ownerUid": {
          ".validate": "newData.isString()"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === root.child('presenceHouseholds').child($householdId).child('ownerUid').val()",
            ".validate": "newData.val() === true || !newData.exists()"
          }
        },
        "reading": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('presenceHouseholds').child($householdId).child('members').child(auth.uid).val() === true",
            ".validate": "!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('memberId').isString() && newData.child('ref').child('bookId').isString() && newData.child('ref').child('chapter').isNumber() && newData.child('startedAt').isString() && newData.child('updatedAt').isString())"
          }
        }
      }
    }
  }
}
